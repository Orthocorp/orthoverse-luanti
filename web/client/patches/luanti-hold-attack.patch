 	// If 1, right-click digging animation
 	s32 m_digging_button = -1;
 
+	f32 m_hold_progress = -1.0f;
+	f32 m_hold_tires = 0.0f;
+	f32 m_hold_amount = 0.0f;
+	bool m_hold_thrust = false;
+
 	// Animation when changing wielded item
 	f32 m_wield_change_timer = 0.125f;
 	ItemStack m_wield_item_next;
diff --git a/src/client/game.cpp b/src/client/game.cpp
index f901556..75a1ce3 100644
--- a/src/client/game.cpp
+++ b/src/client/game.cpp
@@ -2682,6 +2682,33 @@ void Game::processPlayerInteraction(f32 dtime, bool show_hud)
 	const ItemDefinition &selected_def = tool_item.getDefinition(itemdef_manager);
 	f32 d = getToolRange(tool_item, hand_item, itemdef_manager);
 
+	/*
+		Weapons wound up by holding the dig button (item group hold_attack:
+		milliseconds to full strength; hold_tires: when the arm tires;
+		hold_thrust: drawn back rather than raised). While
+		the button is down nothing is dug or punched and the weapon does not
+		swing: the camera raises it instead, and it swings once on release.
+		The server sees the button through the player's controls as usual.
+	*/
+	int hold_ms = itemgroup_get(selected_def.groups, "hold_attack");
+	if (hold_ms > 0) {
+		if (input->isKeyDown(KeyType::DIG)) {
+			runData.hold_attack_time += dtime;
+			int tires_ms = itemgroup_get(selected_def.groups, "hold_tires");
+			camera->setHoldAttack(runData.hold_attack_time * 1000.0f / hold_ms,
+					tires_ms > 0 ? tires_ms / (f32)hold_ms : 0.0f,
+					itemgroup_get(selected_def.groups, "hold_thrust") > 0);
+		} else if (runData.hold_attack_time > 0) {
+			runData.hold_attack_time = 0;
+			camera->setHoldAttack(-1.0f, 0.0f, false);
+			camera->setDigging(0); // the blow
+		}
+		runData.dig_masked = true;
+	} else if (runData.hold_attack_time > 0) {
+		runData.hold_attack_time = 0;
+		camera->setHoldAttack(-1.0f, 0.0f, false);
+	}
+
 	core::line3d<f32> shootline;
 
 	switch (camera->getCameraMode()) {
@@ -2815,6 +2842,7 @@ void Game::processPlayerInteraction(f32 dtime, bool show_hud)
 	if (runData.punching || wasKeyPressed(KeyType::DIG))
 		camera->setDigging(0); // dig animation
 
+	runData.dig_masked = false;
 	input->clearWasKeyPressed();
 	input->clearWasKeyReleased();
 	// Ensure DIG & PLACE are marked as handled
