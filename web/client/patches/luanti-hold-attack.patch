@@ -150,6 +150,20 @@ class Camera
 	// Pass 0 for left click, 1 for right click
 	void setDigging(s32 button);
 
+	// A weapon being wound up: progress 0 .. 1 to full strength (more when
+	// held on), tires: the progress at which the arm tires (0: never),
+	// style: 0 raised, 1 levelled (thrusting), 2 drawn back (a spear's
+	// jab); progress < 0: not winding up
+	void setHoldAttack(f32 progress, f32 tires, int style)
+	{
+		m_hold_progress = progress;
+		m_hold_tires = tires;
+		if (progress >= 0)
+			m_hold_style = style;
+	}
+
+	// The blow of a thrusting weapon: a jab forward instead of a swing
+	void setJab() { m_jab_time = 0.0f; }
 	// Replace the wielded item mesh
 	void wield(const ItemStack &item, bool animate = true);
 
@@ -248,6 +262,12 @@ class Camera
 	// If 1, right-click digging animation
 	s32 m_digging_button = -1;
 
+	f32 m_hold_progress = -1.0f;
+	f32 m_hold_tires = 0.0f;
+	f32 m_hold_amount = 0.0f;
+	int m_hold_style = 0;
+	f32 m_jab_time = -1.0f;
+
 	// Animation when changing wielded item
 	f32 m_wield_change_timer = 0.125f;
 	ItemStack m_wield_item_next;
diff --git a/src/client/game.cpp b/src/client/game.cpp
index a1ac678..cc52d8f 100644
--- a/src/client/game.cpp
+++ b/src/client/game.cpp
@@ -2684,6 +2684,46 @@ void Game::processPlayerInteraction(f32 dtime, bool show_hud)
 	const ItemDefinition &selected_def = tool_item.getDefinition(itemdef_manager);
 	f32 d = getToolRange(tool_item, hand_item, itemdef_manager);
 
+	/*
+		Weapons wound up by holding the dig button (item group hold_attack:
+		milliseconds to full strength; hold_tires: when the arm tires;
+		hold_thrust: levelled rather than raised; hold_jab: drawn back, and
+		jabbed forward on release; hold_recover: the pause after a blow before
+		the next winds up). While
+		the button is down nothing is dug or punched and the weapon does not
+		swing: the camera raises it instead, and it swings once on release.
+		The server sees the button through the player's controls as usual.
+	*/
+	int hold_ms = itemgroup_get(selected_def.groups, "hold_attack");
+	// After a blow the arm recovers (item group hold_recover: milliseconds)
+	// before the next can be wound up: held through it, the wind-up starts
+	// when it ends, as the server counts it
+	runData.hold_recover_left = std::max(0.0f, runData.hold_recover_left - dtime);
+	if (hold_ms > 0) {
+		if (input->isKeyDown(KeyType::DIG) && runData.hold_recover_left > 0) {
+			// still recovering: nothing yet
+		} else if (input->isKeyDown(KeyType::DIG)) {
+			runData.hold_attack_time += dtime;
+			int tires_ms = itemgroup_get(selected_def.groups, "hold_tires");
+			int style = itemgroup_get(selected_def.groups, "hold_jab") > 0 ? 2
+					: itemgroup_get(selected_def.groups, "hold_thrust") > 0 ? 1 : 0;
+			camera->setHoldAttack(runData.hold_attack_time * 1000.0f / hold_ms,
+					tires_ms > 0 ? tires_ms / (f32)hold_ms : 0.0f, style);
+		} else if (runData.hold_attack_time > 0) {
+			runData.hold_attack_time = 0;
+			runData.hold_recover_left = itemgroup_get(selected_def.groups, "hold_recover") / 1000.0f;
+			camera->setHoldAttack(-1.0f, 0.0f, 0);
+			if (itemgroup_get(selected_def.groups, "hold_jab") > 0)
+				camera->setJab(); // the blow
+			else
+				camera->setDigging(0);
+		}
+		runData.dig_masked = true;
+	} else if (runData.hold_attack_time > 0) {
+		runData.hold_attack_time = 0;
+		camera->setHoldAttack(-1.0f, 0.0f, 0);
+	}
+
 	core::line3d<f32> shootline;
 
 	switch (camera->getCameraMode()) {
@@ -2817,6 +2857,7 @@ void Game::processPlayerInteraction(f32 dtime, bool show_hud)
 	if (runData.punching || wasKeyPressed(KeyType::DIG))
 		camera->setDigging(0); // dig animation
 
+	runData.dig_masked = false;
 	input->clearWasKeyPressed();
 	input->clearWasKeyReleased();
 	// Ensure DIG & PLACE are marked as handled
