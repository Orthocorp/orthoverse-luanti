[Unit]
Description=Orthoverse web proxy (browser players to the Luanti server)
After=network-online.target orthoverse.service
Wants=network-online.target

[Service]
User=@SVC_USER@
Group=@SVC_USER@
WorkingDirectory=@BASE@/web/proxy
ExecStart=@BASE@/node/bin/node proxy.js
Environment=OV_PROXY_HOST=127.0.0.1
Environment=OV_PROXY_PORT=@PROXY_PORT@
Environment=OV_TARGET_HOST=127.0.0.1
Environment=OV_TARGET_PORT=30000
Environment=OV_VIRTUAL_IP=10.58.0.1
Environment=OV_MAX_SOCKETS=100
Environment=OV_MAX_PER_IP=6
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=@BASE@/web/proxy

[Install]
WantedBy=multi-user.target
