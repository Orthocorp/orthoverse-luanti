# Copy to .env (next to compose.yaml) and adjust. docker compose reads it.

# The world: the directory with world.mt, map.sqlite and auth.sqlite
OV_WORLD=/mnt/ethereum/orthoverse/luanti/worlds/orthoverse
# Map tiles (map/), the browser game (play/), player names (auth/) and the
# chain index (chain/) live here
OV_DATA=/mnt/ethereum/orthoverse/data
# The user and group that own the world: id -u ovserver, id -g ovserver
OV_UID=
OV_GID=
# The admin's player name (exactly as registered, capitals included): that
# player has every privilege, such as fly, noclip, fast and granting others
OV_ADMIN=
# Where the website listens on this machine (127.0.0.1 only); the Cloudflare
# tunnel's orthoverse.land rule points here
OV_WEB_PORT=8485
# Pin the game server to this NUMA node (CPUs and memory); empty: no pinning
OV_NUMA_NODE=0
# Browser players at once, and from one address
OV_MAX_SOCKETS=100
OV_MAX_PER_IP=6
# Wallet sign-in: a long random secret, made once with: openssl rand -hex 32
# (players' game passwords are derived from it: changing it locks wallet players out)
OV_AUTH_SECRET=
# Where land ownership is read: an Ethereum mainnet RPC endpoint (a keyed one
# such as https://eth-mainnet.g.alchemy.com/v2/<key> is more dependable than the
# free public one; keep the key here, never in the repository), and the
# Orthoverse contract
OV_ETH_RPC=https://ethereum-rpc.publicnode.com
OV_CONTRACT=0x118aeD2606D02C2545C6D7D2d1021e567cc08922
# How often the chain service reads new transfers and castle levels (hours)
OV_CHAIN_EVERY_HOURS=24
# The site's address, for the links in the token metadata
OV_PUBLIC_URL=https://orthoverse.land

# The look of the world for every player: a texture pack from texturepacks/
# (soothing32, by Zughy), or none for Minetest Game's own textures. After a
# change: docker compose up -d --build luanti (players see it when they next join)
OV_TEXTURES=soothing32
