@@ -3,6 +3,7 @@
 // Copyright (C) 2010-2013 celeron55, Perttu Ahola <celeron55@gmail.com>
 
 #include "camera.h"
+#include <sstream>
 #include "client.h"
 #include "clientmap.h"     // MapDrawControl
 #include "localplayer.h"
@@ -39,6 +40,24 @@ static const char *setting_names[] = {
 	"show_nametag_backgrounds",
 };
 
+// The pose of a wound-up weapon, added to the wield position and rotation:
+// raised for slashing and bashing weapons, drawn back for thrusting ones
+// (hold_pose and hold_pose_thrust = "dx dy dz rx ry rz" in the settings
+// override them, for tuning)
+static void hold_pose(bool thrust, f32 v[6])
+{
+	static const f32 raised[6] = {0.0f, 22.0f, 0.0f, 0.0f, 0.0f, 30.0f};
+	static const f32 drawn[6] = {-12.0f, 6.0f, 2.0f, 0.0f, -30.0f, 0.0f};
+	const f32 *def = thrust ? drawn : raised;
+	for (int i = 0; i < 6; i++)
+		v[i] = def[i];
+	const char *key = thrust ? "hold_pose_thrust" : "hold_pose";
+	if (g_settings->exists(key)) {
+		std::istringstream is(g_settings->get(key));
+		for (int i = 0; i < 6 && (is >> v[i]); i++) {}
+	}
+}
+
 Camera::Camera(MapDrawControl &draw_control, Client *client, RenderingEngine *rendering_engine):
 	m_draw_control(draw_control),
 	m_client(client),
@@ -540,6 +559,32 @@ void Camera::update(LocalPlayer* player, f32 frametime, f32 tool_reload_ratio)
 		wield_position.X -= std::sin(bobfrac*M_PI*2.0) * 3.0;
 		wield_position.Y += std::sin(my_modf(bobfrac*2.0)*M_PI) * 3.0;
 	}
+	{
+		// Raised (or drawn back) as the blow gathers strength; on release it
+		// comes down quickly while the ordinary swing plays
+		f32 target = 0.0f;
+		if (m_hold_progress >= 0) {
+			f32 p = std::min(m_hold_progress, 1.0f);
+			target = 1.0f - (1.0f - p) * (1.0f - p);
+		}
+		if (target >= m_hold_amount)
+			m_hold_amount = target;
+		else
+			m_hold_amount = std::max(target, m_hold_amount - frametime * 6.0f);
+		if (m_hold_amount > 0) {
+			f32 hp[6];
+			hold_pose(m_hold_thrust, hp);
+			f32 e = m_hold_amount;
+			wield_position += v3f(hp[0], hp[1], hp[2]) * e;
+			wield_rotation += v3f(hp[3], hp[4], hp[5]) * e;
+		}
+		if (m_hold_progress >= 0 && m_hold_tires > 0 && m_hold_progress > m_hold_tires) {
+			// the arm tires: sagging and trembling
+			f32 t = m_hold_progress - m_hold_tires;
+			wield_position.X += std::sin(t * 40.0f) * 1.2f;
+			wield_position.Y -= std::min(t, 1.0f) * 10.0f;
+		}
+	}
 	m_wieldnode->setPosition(wield_position);
 	m_wieldnode->setRotation(wield_rotation);
 
