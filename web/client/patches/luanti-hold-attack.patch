 	"show_nametag_backgrounds",
 };
 
+// The pose of a wound-up weapon, added to the wield position and rotation:
+// raised for slashing and bashing weapons, levelled for thrusting ones, and
+// pointed at the target for a spear's jab (hold_pose, hold_pose_thrust and
+// hold_pose_jab = "dx dy dz rx ry rz" in the settings override them, for tuning)
+static void hold_pose(int style, f32 v[6])
+{
+	static const f32 poses[3][6] = {
+		{0.0f, 22.0f, 0.0f, 0.0f, 0.0f, 30.0f},
+		{-12.0f, 6.0f, 2.0f, 0.0f, -30.0f, 0.0f},
+		{-40.0f, 0.0f, 6.0f, 0.0f, 72.0f, 40.0f},
+	};
+	static const char *keys[3] = {"hold_pose", "hold_pose_thrust", "hold_pose_jab"};
+	style = std::max(0, std::min(2, style));
+	for (int i = 0; i < 6; i++)
+		v[i] = poses[style][i];
+	if (g_settings->exists(keys[style])) {
+		std::istringstream is(g_settings->get(keys[style]));
+		for (int i = 0; i < 6 && (is >> v[i]); i++) {}
+	}
+}
+
 Camera::Camera(MapDrawControl &draw_control, Client *client, RenderingEngine *rendering_engine):
 	m_draw_control(draw_control),
 	m_client(client),
@@ -540,6 +562,53 @@ void Camera::update(LocalPlayer* player, f32 frametime, f32 tool_reload_ratio)
 		wield_position.X -= std::sin(bobfrac*M_PI*2.0) * 3.0;
 		wield_position.Y += std::sin(my_modf(bobfrac*2.0)*M_PI) * 3.0;
 	}
+	{
+		// Raised (or drawn back) as the blow gathers strength; on release it
+		// comes down quickly while the ordinary swing plays
+		f32 target = 0.0f;
+		if (m_hold_progress >= 0) {
+			f32 p = std::min(m_hold_progress, 1.0f);
+			target = 1.0f - (1.0f - p) * (1.0f - p);
+		}
+		if (target >= m_hold_amount)
+			m_hold_amount = target;
+		else if (m_jab_time < 0)   // a jab keeps its aim until it is back
+			m_hold_amount = std::max(target, m_hold_amount - frametime * 6.0f);
+		if (m_hold_amount > 0) {
+			f32 hp[6];
+			hold_pose(m_hold_style, hp);
+			f32 e = m_hold_amount;
+			wield_position += v3f(hp[0], hp[1], hp[2]) * e;
+			wield_rotation += v3f(hp[3], hp[4], hp[5]) * e;
+		}
+		if (m_jab_time >= 0) {
+			// a jab: driven straight out along the spear, quickly, and drawn
+			// back more slowly (hold_jab_time and hold_jab_vector in the
+			// settings override it, for tuning)
+			f32 jab_time = 0.28f, jv[3] = {-12.0f, 2.0f, 40.0f};
+			if (g_settings->exists("hold_jab_time"))
+				jab_time = std::max(0.05f, g_settings->getFloat("hold_jab_time"));
+			if (g_settings->exists("hold_jab_vector")) {
+				std::istringstream is(g_settings->get("hold_jab_vector"));
+				for (int i = 0; i < 3 && (is >> jv[i]); i++) {}
+			}
+			m_jab_time += frametime;
+			f32 f = m_jab_time / jab_time;
+			if (f >= 1.0f) {
+				m_jab_time = -1.0f;
+			} else {
+				f32 out = f < 0.3f ? std::sin(f / 0.3f * (f32)M_PI * 0.5f)
+					: std::cos((f - 0.3f) / 0.7f * (f32)M_PI * 0.5f);
+				wield_position += v3f(jv[0], jv[1], jv[2]) * out;
+			}
+		}
+		if (m_hold_progress >= 0 && m_hold_tires > 0 && m_hold_progress > m_hold_tires) {
+			// the arm tires: sagging and trembling
+			f32 t = m_hold_progress - m_hold_tires;
+			wield_position.X += std::sin(t * 40.0f) * 1.2f;
+			wield_position.Y -= std::min(t, 1.0f) * 10.0f;
+		}
+	}
 	m_wieldnode->setPosition(wield_position);
 	m_wieldnode->setRotation(wield_rotation);
 
